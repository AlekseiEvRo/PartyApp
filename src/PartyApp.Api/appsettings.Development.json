{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/party.db;Cache=Shared;Foreign Keys=True"
  },
  "Jwt": {
    "Issuer": "party-app",
    "Audience": "party-app-clients",
    "SigningKey": "SuperSecretKeyForDevelopmentOnly12345!",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 30
  },
  "Files": {
    "UploadRoot": "App_Data/uploads"
  },
  "Party": {
    "WelcomeBonus": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Toast": {
    "Points": 1,
    "CooldownSeconds": 60
  }
}