{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/party.db;Cache=Shared;Foreign Keys=True"
  },
  "Jwt": {
    "Issuer": "party-app",
    "Audience": "party-app-clients",
    "SigningKey": "SuperSecretKeyForDevelopmentOnly12345!",
    "AccessTokenLifetimeMinutes": 720
  },
  "Files": {
    "UploadRoot": "App_Data/uploads"
  },
  "Party": {
    "WelcomeBonus": 100
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "SubmitTokenLimit": 30,
    "SubmitRefillSeconds": 60
  },
  "Photos": {
    "MaxSizeBytes": 10485760,
    "RequireModeration": true
  },
  "Wishes": {
    "RequireModeration": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Dictionary": {
    "FilePath": "App_Data/russian.txt"
  }
}